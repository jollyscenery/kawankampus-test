rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function attendancePath(eventId, uid) {
      return /databases/$(database)/documents/eventAttendees/$(eventId + '_' + uid);
    }

    function membershipPath(communityId, uid) {
      return /databases/$(database)/documents/communityMemberships/$(communityId + '_' + uid);
    }

    function communityPath(communityId) {
      return /databases/$(database)/documents/communities/$(communityId);
    }

    // User profiles (unchanged).
    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    // Public profiles (unchanged).
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Communities (unchanged).
    match /communities/{communityId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.created_by == request.auth.uid;

      match /members/{memberId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.user_id == request.auth.uid;

        allow delete: if signedIn()
          && request.auth.uid == memberId;
      }
    }

    // Community membership records (unchanged).
    match /communityMemberships/{membershipId} {
      allow read: if signedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.community_id is string
        && membershipId == request.resource.data.community_id + '_' + request.auth.uid
        && exists(communityPath(request.resource.data.community_id));

      allow delete: if signedIn()
        && resource.data.user_id == request.auth.uid;
    }

    // Events: only members may create, and the creator's attendance
    // must be part of the same atomic batch.
    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'community_id', 'community_name', 'title', 'event_date',
          'place', 'description', 'attendee_count', 'created_by', 'created_at'
        ])
        && request.resource.data.keys().hasOnly([
          'community_id', 'community_name', 'title', 'event_date',
          'place', 'description', 'attendee_count', 'created_by', 'created_at'
        ])
        && request.resource.data.community_id is string
        && request.resource.data.community_name is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.event_date is string
        && request.resource.data.place is string
        && request.resource.data.place.size() > 0
        && request.resource.data.description is string
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.attendee_count == 1
        && request.resource.data.created_at == request.time
        && exists(communityPath(request.resource.data.community_id))
        && get(communityPath(request.resource.data.community_id)).data.name
          == request.resource.data.community_name
        && exists(membershipPath(request.resource.data.community_id, request.auth.uid))
        && !exists(attendancePath(eventId, request.auth.uid))
        && existsAfter(attendancePath(eventId, request.auth.uid))
        && getAfter(attendancePath(eventId, request.auth.uid)).data.event_id == eventId
        && getAfter(attendancePath(eventId, request.auth.uid)).data.user_id == request.auth.uid;

      // Only a +1 count increment paired with a first-time attendance
      // record for the signed-in user may update an existing event.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendee_count'])
        && request.resource.data.attendee_count == resource.data.attendee_count + 1
        && !exists(attendancePath(eventId, request.auth.uid))
        && existsAfter(attendancePath(eventId, request.auth.uid))
        && getAfter(attendancePath(eventId, request.auth.uid)).data.event_id == eventId
        && getAfter(attendancePath(eventId, request.auth.uid)).data.user_id == request.auth.uid;

      // The current UI has no event deletion workflow.
      allow delete: if false;
    }

    // Public landing page: only sanitized, intentionally published event summaries.
    // These documents contain no creator UID, attendee list, or private event details.
    match /publicEvents/{eventId} {
      allow read: if true;

      // A preview may be created only in the same atomic batch as its source
      // event, by the authenticated creator, with identical public fields.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'title', 'event_date', 'place', 'community_name', 'published_at'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'event_date', 'place', 'community_name', 'published_at'
        ])
        && request.resource.data.title is string
        && request.resource.data.event_date is string
        && request.resource.data.place is string
        && request.resource.data.community_name is string
        && request.resource.data.published_at == request.time
        && !exists(eventPath(eventId))
        && existsAfter(eventPath(eventId))
        && getAfter(eventPath(eventId)).data.created_by == request.auth.uid
        && getAfter(eventPath(eventId)).data.title == request.resource.data.title
        && getAfter(eventPath(eventId)).data.event_date == request.resource.data.event_date
        && getAfter(eventPath(eventId)).data.place == request.resource.data.place
        && getAfter(eventPath(eventId)).data.community_name == request.resource.data.community_name;

      allow update, delete: if false;
    }

    // Top-level attendance collection used by the Firestore Kegiatan patch.
    match /eventAttendees/{attendanceId} {
      // The app reads its own registration, including when not yet present.
      // All existing records use {eventId}_{uid} as the document ID.
      allow get: if signedIn()
        && attendanceId.matches('.*_' + request.auth.uid);

      // The app queries only its own registration records by user_id.
      allow list: if signedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'event_id', 'user_id', 'created_at'
        ])
        && request.resource.data.keys().hasOnly([
          'event_id', 'user_id', 'created_at'
        ])
        && request.resource.data.event_id is string
        && request.resource.data.user_id == request.auth.uid
        && attendanceId == request.resource.data.event_id + '_' + request.auth.uid
        && request.resource.data.created_at == request.time
        && existsAfter(eventPath(request.resource.data.event_id))
        && (
          (
            // First registration: the event is being created now.
            !exists(eventPath(request.resource.data.event_id))
            && getAfter(eventPath(request.resource.data.event_id)).data.created_by == request.auth.uid
            && getAfter(eventPath(request.resource.data.event_id)).data.attendee_count == 1
          )
          ||
          (
            // Existing event: its count is incremented in the same transaction.
            exists(eventPath(request.resource.data.event_id))
            && getAfter(eventPath(request.resource.data.event_id)).data.attendee_count
              == get(eventPath(request.resource.data.event_id)).data.attendee_count + 1
          )
        );

      allow update, delete: if false;
    }

    // Connect: users can access only their own connections (unchanged).
    match /connections/{connectionId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'status', 'createdAt'
        ]);

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if signedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
