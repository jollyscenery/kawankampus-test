{
    "hosting":  {
                    "public":  "dist",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                },
    "firestore":  {
                      "database":  "default",
                      "rules":  "firestore.rules",
                      "edition":  "enterprise"
                  },
    "emulators":  {
                      "firestore":  {
                                        "host":  "127.0.0.1",
                                        "port":  8180
                                    },
                      "ui":  {
                                 "enabled":  false,
                                 "port":  4000
                             },
                      "auth":  {
                                   "host":  "127.0.0.1",
                                   "port":  9099
                               }
                  }
}